# Client-side Expo public environment variables
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_revenuecat_android_key

# Server-side Supabase Edge Function secrets (set via `supabase secrets set`)
# VISION_API_KEY=your-gemini-or-openai-vision-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
